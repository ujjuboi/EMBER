# --- Partner sync ---
# Real signaling relay (Cloudflare Worker, see relay/README.md) or local relay
# (`npm run relay`). The app appends `?room=<code>` itself.
VITE_RELAY_URL=ws://127.0.0.1:8787

# UI-only mode: scripted partner events, no relay/network needed.
# VITE_SYNC_MODE=mock

# STUN for NAT traversal during the WebRTC handshake (default shown).
# VITE_STUN_URL=stun:stun.l.google.com:19302